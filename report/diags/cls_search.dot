digraph G {
rankdir=BT; nodesep=0.35; ranksep=0.55; fontname="DejaVu Sans";
node [fontname="DejaVu Sans", fontsize=10, shape=plain];
edge [fontname="DejaVu Sans", fontsize=9, color="#5b4f47"];
"Filter" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#f7ead9"><tr><td><font point-size="8">«specification»</font></td></tr><tr><td><b>Filter</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">degree(x): [0,1]</td></tr><tr><td align="left" balign="left">matches(x)</td></tr><tr><td align="left" balign="left">describe()</td></tr><tr><td align="left" balign="left">relaxed(): Filter?</td></tr></table></td></tr></table>>];
"RangeFilter" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>RangeFilter</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">low, high, span</td></tr></table></td></tr></table>>];
"ChoiceFilter" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>ChoiceFilter</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">allowed</td></tr></table></td></tr></table>>];
"FlagFilter" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>FlagFilter</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">expected</td></tr></table></td></tr></table>>];
"TasteFilter" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>TasteFilter</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">nodes</td></tr></table></td></tr></table>>];
"SugarClassFilter" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>SugarClassFilter</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">allowed</td></tr></table></td></tr></table>>];
"TextFilter" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>TextFilter</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">needle</td></tr></table></td></tr></table>>];
"SearchQuery" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><font point-size="8">«AND-композиция»</font></td></tr><tr><td><b>SearchQuery</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">matches(x)</td></tr><tr><td align="left" balign="left">utility(x)</td></tr><tr><td align="left" balign="left">unmet(x)</td></tr></table></td></tr></table>>];
"QueryParser" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><font point-size="8">«builder»</font></td></tr><tr><td><b>QueryParser</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">parse(json): SearchQuery</td></tr></table></td></tr></table>>];
"UtilityFunction" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>UtilityFunction</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">score(query, x, r)</td></tr></table></td></tr></table>>];
"RelaxationAdvisor" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>RelaxationAdvisor</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">advise(query, items)</td></tr></table></td></tr></table>>];
"SearchEngine" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>SearchEngine</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">search(query, pool, relevance)</td></tr></table></td></tr></table>>];
"Command" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#f7ead9"><tr><td><font point-size="8">«command»</font></td></tr><tr><td><b>Command</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">execute(session, payload)</td></tr><tr><td align="left" balign="left">step(...)</td></tr></table></td></tr></table>>];
"SearchCommand" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>SearchCommand</b></td></tr></table>>];
"RefineCommand" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>RefineCommand</b></td></tr></table>>];
"RecommendCommand" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>RecommendCommand</b></td></tr></table>>];
"Session" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><b>Session</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">profile</td></tr><tr><td align="left" balign="left">rate(kind, id)</td></tr><tr><td align="left" balign="left">reset()</td></tr></table></td></tr></table>>];
"History" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><font point-size="8">«caretaker»</font></td></tr><tr><td><b>History</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">push(step)</td></tr><tr><td align="left" balign="left">select(i)</td></tr><tr><td align="left" balign="left">current</td></tr></table></td></tr></table>>];
"Step" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><font point-size="8">«memento»</font></td></tr><tr><td><b>Step</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">kind, title, rows</td></tr><tr><td align="left" balign="left">filters, settings</td></tr></table></td></tr></table>>];
"UnifiedService" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><font point-size="8">«facade»</font></td></tr><tr><td><b>UnifiedService</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">execute(session, kind, json)</td></tr><tr><td align="left" balign="left">rate(...)</td></tr></table></td></tr></table>>];
"RecommendationService" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#e9f0fa"><tr><td><font point-size="8">«ЛР3»</font></td></tr><tr><td><b>RecommendationService</b></td></tr></table>>];
"RangeFilter" -> "Filter" [arrowhead=onormal];
"ChoiceFilter" -> "Filter" [arrowhead=onormal];
"FlagFilter" -> "Filter" [arrowhead=onormal];
"TasteFilter" -> "Filter" [arrowhead=onormal];
"SugarClassFilter" -> "Filter" [arrowhead=onormal];
"TextFilter" -> "Filter" [arrowhead=onormal];
"SearchCommand" -> "Command" [arrowhead=onormal];
"RefineCommand" -> "Command" [arrowhead=onormal];
"RecommendCommand" -> "Command" [arrowhead=onormal];
"SearchQuery" -> "Filter" [arrowhead=vee, arrowtail=odiamond, dir=both, label="0..*"];
"QueryParser" -> "SearchQuery" [arrowhead=vee, style=dashed, label="создаёт"];
"SearchEngine" -> "SearchQuery" [arrowhead=vee, style=dashed, label=""];
"SearchEngine" -> "UtilityFunction" [arrowhead=vee, arrowtail=odiamond, dir=both, label=""];
"SearchEngine" -> "RelaxationAdvisor" [arrowhead=vee, arrowtail=odiamond, dir=both, label=""];
"Command" -> "SearchEngine" [arrowhead=vee, style=dashed, label=""];
"Command" -> "QueryParser" [arrowhead=vee, style=dashed, label=""];
"RecommendCommand" -> "RecommendationService" [arrowhead=vee, style=dashed, label=""];
"Session" -> "History" [arrowhead=vee, arrowtail=odiamond, dir=both, label=""];
"History" -> "Step" [arrowhead=vee, arrowtail=odiamond, dir=both, label="0..*"];
"UnifiedService" -> "Command" [arrowhead=vee, arrowtail=odiamond, dir=both, label="реестр"];
"Command" -> "Session" [arrowhead=vee, style=dashed, label=""];
}
