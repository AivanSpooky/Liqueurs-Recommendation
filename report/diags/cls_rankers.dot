"WeightedMeanRanker" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#7a1f3d" bgcolor="#ffffff"><tr><td><font point-size="8">«template method»</font></td></tr><tr><td><b>WeightedMeanRanker</b></td></tr><tr><td><table border="0" cellspacing="0" cellpadding="1"><tr><td align="left" balign="left">weights(likes)</td></tr></table></td></tr></table>>];
