digraph G {
rankdir=BT; nodesep=0.35; ranksep=0.55; fontname="DejaVu Sans";
node [fontname="DejaVu Sans", fontsize=10, shape=plain];
edge [fontname="DejaVu Sans", fontsize=9, color="#5b4f47"];
